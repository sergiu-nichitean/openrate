<%= link_to 'New Broadcast', new_broadcast_path, class: 'btn btn-success float-right' %>

<h1>Broadcasts</h1>

<% unless current_user.broadcasts.sending.empty? %>
  <h2>Sending</h2>

  <div class="responsive-table">
    <table class="table table-bordered table-hover">
      <thead>
        <tr>
          <th>Subject</th>
          <th>Sent at</th>
          <th>Audience size</th>
          <th>Emails sent</th>
          <th>Opens</th>
          <th>Clicks</th>
          <th>Unsubscribes</th>
          <th colspan="3"></th>
        </tr>
      </thead>

      <tbody>
        <% current_user.broadcasts.sending.each do |broadcast| %>
          <tr>
            <td><%= broadcast.message.subject %></td>
            <td><%= broadcast.send_at %></td>
            <td><%= broadcast.audience_size %></td>
            <td><%= broadcast.emails_sent %> (<%= broadcast.emails_sent_percentage %>)</td>
            <td><%= broadcast.opens %> (<%= broadcast.opens_percentage %>)</td>
            <td><%= broadcast.clicks %> (<%= broadcast.clicks_percentage %>)</td>
            <td><%= broadcast.unsubscribes %></td>
            <td><%= link_to 'View Details', broadcast_path(broadcast) %></td>
            <td><%= link_to 'Duplicate', "#duplicate-#{broadcast.id}" %></td>
            <td><%= link_to 'Cancel', "/broadcast_cancel/#{broadcast.id}", data: { confirm: 'Are you sure you want to cancel this broadcast?' } %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>

<% unless current_user.broadcasts.drafts.empty? %>
  <h2>Drafts</h2>

  <div class="responsive-table">
    <table class="table table-bordered table-hover">
      <thead>
        <tr>
          <th>Subject</th>
          <th>Date created</th>
          <th>Last updated</th>
          <th colspan="3"></th>
        </tr>
      </thead>

      <tbody>
        <% current_user.broadcasts.drafts.each do |broadcast| %>
          <tr>
            <td><%= broadcast.message.subject %></td>
            <td><%= broadcast.created_at %></td>
            <td><%= broadcast.updated_at %></td>
            <td><%= link_to 'Edit', edit_broadcast_path(broadcast) %></td>
            <td><%= link_to 'Duplicate', '#' %></td>
            <td><%= link_to 'Delete', broadcast, method: :delete, data: { confirm: 'Are you sure?' } %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>

<% unless current_user.broadcasts.scheduled.empty? %>
  <h2>Scheduled</h2>

  <div class="responsive-table">
    <table class="table table-bordered table-hover">
      <thead>
        <tr>
          <th>Subject</th>
          <th>Send at</th>
          <th>Last updated</th>
          <th colspan="3"></th>
        </tr>
      </thead>

      <tbody>
        <% current_user.broadcasts.scheduled.each do |broadcast| %>
          <tr>
            <td><%= broadcast.message.subject %></td>
            <td><%= broadcast.send_at %></td>
            <td><%= broadcast.updated_at %></td>
            <td><%= link_to 'Edit', edit_broadcast_path(broadcast) %></td>
            <td><%= link_to 'Duplicate', '#' %></td>
            <td><%= link_to 'Delete', broadcast, method: :delete, data: { confirm: 'Are you sure?' } %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>

<% unless current_user.broadcasts.sent.empty? %>
  <h2>History</h2>

  <div class="responsive-table">
    <table class="table table-bordered table-hover">
      <thead>
        <tr>
          <th>Subject</th>
          <th>Sent at</th>
          <th>Audience size</th>
          <th>Emails sent</th>
          <th>Opens</th>
          <th>Clicks</th>
          <th>Unsubscribes</th>
          <th colspan="2"></th>
        </tr>
      </thead>

      <tbody>
        <% current_user.broadcasts.sent.each do |broadcast| %>
          <tr>
            <td><%= broadcast.message.subject %></td>
            <td><%= broadcast.send_at %></td>
            <td><%= broadcast.audience_size %></td>
            <td><%= broadcast.emails_sent %> (<%= broadcast.emails_sent_percentage %>)</td>
            <td><%= broadcast.opens %> (<%= broadcast.opens_percentage %>)</td>
            <td><%= broadcast.clicks %> (<%= broadcast.clicks_percentage %>)</td>
            <td><%= broadcast.unsubscribes %></td>
            <td><%= link_to 'View Details', broadcast_path(broadcast) %></td>
            <td><%= link_to 'Duplicate', "#duplicate-#{broadcast.id}" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>

<% unless current_user.broadcasts.canceled.empty? %>
  <h2>Canceled</h2>

  <div class="responsive-table">
    <table class="table table-bordered table-hover">
      <thead>
        <tr>
          <th>Subject</th>
          <th>Sent at</th>
          <th>Audience size</th>
          <th>Emails sent</th>
          <th>Opens</th>
          <th>Clicks</th>
          <th>Unsubscribes</th>
          <th colspan="2"></th>
        </tr>
      </thead>

      <tbody>
        <% current_user.broadcasts.canceled.each do |broadcast| %>
          <tr>
            <td><%= broadcast.message.subject %></td>
            <td><%= broadcast.send_at %></td>
            <td><%= broadcast.message.audience_size.to_i %></td>
            <td><%= broadcast.audience_size %></td>
            <td><%= broadcast.emails_sent %> (<%= broadcast.emails_sent_percentage %>)</td>
            <td><%= broadcast.opens %> (<%= broadcast.opens_percentage %>)</td>
            <td><%= broadcast.clicks %> (<%= broadcast.clicks_percentage %>)</td>
            <td><%= broadcast.unsubscribes %></td>
            <td><%= link_to 'View Details', broadcast_path(broadcast) %></td>
            <td><%= link_to 'Duplicate', "#duplicate-#{broadcast.id}" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
