<%= link_to 'New Broadcast', new_broadcast_path, class: 'btn btn-success float-right' %>

<h1>Broadcasts</h1>

<% unless @sending.empty? %>
  <h2>Sending</h2>

  <div class="responsive-table">
    <table class="table table-bordered table-hover">
      <thead>
        <tr>
          <th>Subject</th>
          <th>Sent at</th>
          <th>Audience size</th>
          <th>Emails sent</th>
          <th>Opens</th>
          <th>Unsubscribes</th>
          <th colspan="3"></th>
        </tr>
      </thead>

      <tbody>
        <% @sending.each do |broadcast| %>
          <tr>
            <td><%= broadcast.message.subject %></td>
            <td><%= broadcast.send_at %></td>
            <td><%= broadcast.message.audience_size.to_i %></td>
            <td><%= broadcast.message.emails_sent.to_i %> (<%= broadcast.message.audience_size.to_i.zero? ? '0' : '%.2f' % (broadcast.message.emails_sent.to_i * 100 / broadcast.message.audience_size.to_i) %>%)</td>
            <td><%= broadcast.message.opens.to_i %> (<%= broadcast.message.audience_size.to_i.zero? ? '0' : '%.2f' % (broadcast.message.opens.to_i * 100 / broadcast.message.audience_size.to_i) %>%)</td>
            <td><%= broadcast.message.unsubscribes.to_i %></td>
            <td><%= link_to 'View Details', broadcast_path(broadcast) %></td>
            <td><%= link_to 'Duplicate', "#duplicate-#{broadcast.id}" %></td>
            <td><%= link_to 'Cancel', "/broadcast_cancel/#{broadcast.id}", data: { confirm: 'Are you sure you want to cancel this broadcast?' } %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>

<% unless @drafts.empty? %>
  <h2>Drafts</h2>

  <div class="responsive-table">
    <table class="table table-bordered table-hover">
      <thead>
        <tr>
          <th>Subject</th>
          <th>Date created</th>
          <th>Last updated</th>
          <th colspan="3"></th>
        </tr>
      </thead>

      <tbody>
        <% @drafts.each do |broadcast| %>
          <tr>
            <td><%= broadcast.message.subject %></td>
            <td><%= broadcast.created_at %></td>
            <td><%= broadcast.updated_at %></td>
            <td><%= link_to 'Edit', edit_broadcast_path(broadcast) %></td>
            <td><%= link_to 'Duplicate', '#' %></td>
            <td><%= link_to 'Delete', broadcast, method: :delete, data: { confirm: 'Are you sure?' } %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>

