<h1>Sending Stats for "<%= @broadcast.message.subject %>"</h1>

<h2>Emails sent</h2>

<div class="responsive-table">
  <table class="table table-bordered table-hover">
    <thead>
      <tr>
        <th>ID</th>
        <th>To</th>
        <th>Sent at</th>
        <th>Status</th>
      </tr>
    </thead>

    <tbody>
      <% @broadcast.message.sent_messages.each do |sent_message| %>
        <tr>
          <td><%= sent_message.id %></td>
          <td><%= sent_message.subscriber.email %></td>
          <td><%= sent_message.created_at %></td>
          <td>
            <% if sent_message.status == 'error' %>
              Error: <%= sent_message.error %>
            <% else %>
              <%= sent_message.status.upcase_first %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
