<!DOCTYPE html>
<html>
  <head>
    <title>OpenRateX</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag    'application', media: 'all', 'data-turbolinks-track': 'reload' %>
    <%= javascript_include_tag 'application', 'data-turbolinks-track': 'reload' %>
  </head>

  <body>
      <div class="fixed-sidebar">
        <%= render partial: 'layouts/menu' %>
      </div>
      <div class="content-area">
        <div class="container">
          <% if notice || alert %>
            <div class="alert-block">
              <% if notice %>
                <div class="row">
                  <div class="col-sm-12">
                    <p class="alert alert-success"><%= notice %></p>
                  </div>
                </div>
              <% end %>
              <% if alert %>
                <div class="row">
                  <div class="col-sm-12">
                    <p class="alert alert-danger"><%= alert %></p>
                  </div>
                </div>
              <% end %>
            </div>
          <% end %>

          <% if @page_title %>
            <div class="row">
              <div class="col-sm-12">
                <h1><%= @page_title %></h1>
              </div>
            </div>
          <% end %>

          <%= yield %>
        </div>
      </div>
    </div>
  </body>
</html>
