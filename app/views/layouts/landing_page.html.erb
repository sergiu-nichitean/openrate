<!DOCTYPE html>
<html>
  <head>
    <title>Email Marketing for Free, Send Unlimited Emails to Unlimited Subscribers - OpenRate.io</title>
    <!-- Required meta tags -->
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="description" content="The email marketing platform you've been waiting for: send unlimited emails to unlimited subscribers for free." />
    <meta name="keywords" content="email marketing, email list, subscribers, send emails" />
    <meta name="developer" content="OpenRate.io">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

    <!-- FAV AND ICONS   -->
    <link rel="shortcut icon" href="/landing_page/images/favicon.ico">
    <link rel="shortcut icon" href="/landing_page/images/apple-icon.png">
    <link rel="shortcut icon" sizes="72x72" href="/landing_page/images/apple-icon-72x72.png">
    <link rel="shortcut icon" sizes="114x114" href="/landing_page/images/apple-icon-114x114.png">

    <!-- Font-->
    <link href="https://fonts.googleapis.com/css?family=Source+Sans+Pro" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="/landing_page/icons/font-awesome-4.7.0/css/font-awesome.min.css">
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="/landing_page/plugins/css/bootstrap.min.css">
    <!-- Animate CSS-->
    <link rel="stylesheet" href="/landing_page/plugins/css/animate.css">
    <!-- Owl Carousel CSS-->
    <link rel="stylesheet" href="/landing_page/plugins/css/owl.css">
    <!-- Fancybox-->
    <link rel="stylesheet" href="/landing_page/plugins/css/jquery.fancybox.min.css">
    <!-- Custom CSS-->
    <link rel="stylesheet" href="/landing_page/css/styles.css">
    <link rel="stylesheet" href="/landing_page/css/responsive.css">

    <link rel="stylesheet" href="/landing_page/css/colors/red.css" title="red">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
  </head>

  <body class="black-bg">
    <%= yield %>

    <!--
    ==============
    * JS Files *
    ==============
    -->

    <!-- jQuery first, then Popper.js, then Bootstrap JS -->

    <!-- jQuery -->
    <script src="/landing_page/plugins/js/jquery.min.js"></script>
    <!-- popper -->
    <script src="/landing_page/plugins/js/popper.min.js"></script>
    <!-- bootstrap -->
    <script src="/landing_page/plugins/js/bootstrap.min.js"></script>
    <!-- waypoint  -->
    <script src="/landing_page/plugins/js/waypoints.min.js"></script>
    <!-- owl carousel -->
    <script src="/landing_page/plugins/js/owl.carousel.js"></script>
    <!-- validator -->
    <script src="/landing_page/plugins/js/validator.min.js"></script>
    <!-- wow -->
    <script src="/landing_page/plugins/js/wow.min.js"></script>
    <!-- jquery nav -->
    <script src="/landing_page/plugins/js/jquery.nav.js"></script>
    <!-- Fancybox js-->
    <script src="/landing_page/plugins/js/jquery.fancybox.min.js"></script>
    <!-- counterup -->
    <script src="/landing_page/plugins/js/jquery.counterup.min.js"></script>
    <script src="/landing_page/js/custom-scripts.js"></script>
