<h1>Import Subscribers</h1>

<%= form_tag(submit_import_subscribers_path, method: 'post', enctype: 'multipart/form-data', class: 'form-inline') do %>
  <%= label_tag 'subscriber_feed', 'Upload CSV: ', class: 'mr-4' %>
  <%= file_field_tag 'subscriber_feed' %>
  <%= submit_tag 'Import', class: 'btn btn-primary' %>
<% end %>
