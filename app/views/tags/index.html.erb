<h1>Tags <%= link_to 'New Tag', new_tag_path, class: 'btn btn-success float-right' %></h1>

<table class="table table-bordered table-hover">
  <thead>
    <tr>
      <th>Name</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @tags.each do |tag| %>
      <tr>
        <td><%= tag.name %></td>
        <td width="1%"><%= link_to 'Show', tag %></td>
        <td width="1%"><%= link_to 'Edit', edit_tag_path(tag) %></td>
        <td width="1%"><%= link_to 'Destroy', tag, method: :delete, data: { confirm: 'Are you sure?' } %></td>
      </tr>
    <% end %>
  </tbody>
</table>
